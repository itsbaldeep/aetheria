# Aetheria environment — copy to /etc/aetheria/env on the VPS (and deploy/env locally).
# NEVER commit real secrets. Generate your own values.

# --- Postgres (aetheria container, port allocated via orch) ---
AETHERIA_PG_HOST=100.64.0.1
AETHERIA_PG_PORT=5004
AETHERIA_PG_DB=aetheria
AETHERIA_PG_USER=aetheria
AETHERIA_PG_PASSWORD=change-me-strong

# --- Redis (aetheria container, port allocated via orch) ---
AETHERIA_REDIS_HOST=100.64.0.1
AETHERIA_REDIS_PORT=5005
AETHERIA_REDIS_PASSWORD=

# --- Service ports (ADR-001, allocated via orch) ---
AETHERIA_AUTH_PORT=3016
AETHERIA_GAME_PORT=3015
AETHERIA_ADMIN_PORT=3017
AETHERIA_PORTAL_PORT=3018
AETHERIA_CONTROL_PORT=5003

# --- Public URLs (ADR-002) ---
AETHERIA_PUBLIC_BASE=https://aetheria.apps.deployden.tech
AETHERIA_AUTH_URL=https://api.aetheria.apps.deployden.tech
AETHERIA_ADMIN_URL=https://admin.aetheria.apps.deployden.tech
AETHERIA_WS_URL=wss://play.aetheria.apps.deployden.tech/ws

# --- Auth ---
AETHERIA_SESSION_TTL_HOURS=24
AETHERIA_SESSION_KEY=generate-a-32-byte-random-secret
AETHERIA_TOTP_ISSUER=Aetheria-Admin

# --- Staging (brief §12.6) ---
AETHERIA_STAGING_DB=aetheria_staging
