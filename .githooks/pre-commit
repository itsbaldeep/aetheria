#!/usr/bin/env bash
# Pre-commit hook: quick local checks. Full CI runs on GitHub Actions.
set -euo pipefail

cd "$(git rev-parse --show-toplevel)"
source "$HOME/.toolchain.env" 2>/dev/null || true

echo "==> gofmt"
bad=$(gofmt -l $(find server tools -name '*.go' -not -path '*/gen/*') 2>/dev/null || true)
if [ -n "$bad" ]; then
  echo "gofmt needed: $bad"
  exit 1
fi

echo "==> contentlint"
go run ./tools/contentlint

echo "==> vet"
go vet ./...
echo "pre-commit checks passed"
